int solveByArray(int N, int M, bool fromFirst, int L = -1) {
    int* people = new int[N];
    for (int i = 0; i < N; ++i) people[i] = i + 1;
    int current_size = N;

    int index = 0;
    while (current_size > 1) {
        index = (index + M - 1) % current_size;
        for (int j = index; j < current_size - 1; ++j) {
            people[j] = people[j + 1];
        }
        current_size--;
        if (index == current_size) index = 0;
    }
    int winner_from_first = people[0];
    delete[] people;

    if (fromFirst) {
        return winner_from_first;
    }

    int start_pos = (L - winner_from_first + N) % N + 1;
    return start_pos;
}

struct Node {
    int data;
    Node* next;
};

Node* createCircularList(int N) {
    if (N <= 0) return nullptr;
    Node* head = new Node{ 1, nullptr };
    Node* tail = head;
    for (int i = 2; i <= N; ++i) {
        tail->next = new Node{ i, nullptr };
        tail = tail->next;
    }
    tail->next = head;
    return head;
}

int solveByList(int N, int M, bool fromFirst, int L = -1) {
    Node* head = createCircularList(N);
    Node* curr = head;
    Node* prev = nullptr;

    Node* tail = head;
    while (tail->next != head) {
        tail = tail->next;
    }
    prev = tail;

    int temp_size = N;
    while (temp_size > 1) {
        for (int k = 1; k < M; ++k) {
            prev = curr;
            curr = curr->next;
        }
        Node* toDelete = curr;
        curr = curr->next;
        prev->next = curr;
        delete toDelete;
        temp_size--;
    }
    int winner_from_first = curr->data;
    delete curr;

    if (fromFirst) {
        return winner_from_first;
    }

    int start_pos = (L - winner_from_first + N) % N + 1;
    return start_pos;
}

class MyQueue {
private:
    int* arr;
    int capacity;
    int head;
    int tail;
    int count;

public:
    MyQueue(int size) {
        capacity = size + 2;
        arr = new int[capacity];
        head = 0;
        tail = 0;
        count = 0;
    }
    ~MyQueue() {
        delete[] arr;
    }
    void push(int val) {
        arr[tail] = val;
        tail = (tail + 1) % capacity;
        count++;
    }
    void pop() {
        if (count == 0) return;
        head = (head + 1) % capacity;
        count--;
    }
    int front() {
        return arr[head];
    }
    int size() {
        return count;
    }
};

int solveByQueue(int N, int M, bool fromFirst, int L = -1) {
    MyQueue q(N);
    for (int i = 1; i <= N; ++i) q.push(i);
    while (q.size() > 1) {
        for (int k = 1; k < M; ++k) {
            q.push(q.front());
            q.pop();
        }
        q.pop();
    }
    int winner_from_first = q.front();

    if (fromFirst) {
        return winner_from_first;
    }

    int start_pos = (L - winner_from_first + N) % N + 1;
    return start_pos;
}

